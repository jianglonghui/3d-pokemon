[resource]
; Buttons only get the pixel font — RichTextLabel uses Godot built-in Noto (CJK-capable)
; set via add_theme_font_override in dialog_overlay.gd _ready()
Button/fonts/font = ExtResource("1_font")
default_font_size = 20

Panel/styles/panel = SubResource("StyleBoxFlat_panel")

Button/colors/font_color = Color(0.92, 0.95, 1.0, 1)
Button/colors/font_hover_color = Color(1.0, 1.0, 0.5, 1)
Button/colors/font_focus_color = Color(1.0, 1.0, 0.5, 1)
Button/colors/font_pressed_color = Color(0.7, 0.9, 1.0, 1)
Button/styles/normal = SubResource("StyleBoxFlat_button_normal")
Button/styles/hover = SubResource("StyleBoxFlat_button_focus")
Button/styles/focus = SubResource("StyleBoxFlat_button_focus")
Button/styles/pressed = SubResource("StyleBoxFlat_button_normal")

ProgressBar/colors/font_color = Color(0, 0, 0, 0)
