[resource]
script = ExtResource("1_text")
text = "The relic belongs to those strong enough to claim it.
Show me your strength!
Or they will carve on your tomb:
HERE LIES THE FOOL WHO CHALLENGED THE SHADOW OF THE DEEP!"
